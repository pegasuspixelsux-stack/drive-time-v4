rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /inventory/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /leads/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    match /messages/{id} {
      allow read, write: if request.auth != null;
    }
    match /users/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
